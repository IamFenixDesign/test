DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
AUTH_SECRET=generate-a-long-random-string

# Google Sign-In (Web client ID from Google Cloud Console → APIs & Services → Credentials)
# Authorized JavaScript origins: https://tu-app.vercel.app and http://localhost:5173
# Authorized redirect URIs: (GIS button does not need redirects for ID token flow)
GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# Optional extra audiences if Android/iOS OAuth clients issue their own ID tokens:
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple (Services ID from Apple Developer → Identifiers)
# Return URLs must include your production origin and http://localhost:5173
APPLE_CLIENT_ID=com.tuapp.service
# Optional explicit redirect (defaults to window origin on the client):
# APPLE_REDIRECT_URI=https://tu-app.vercel.app

# Resend (opcional; ya no se usa para login)
RESEND_API_KEY=
RESEND_ACCOUNT_EMAIL=julian.javier95@hotmail.com
MAIL_FROM=Stockea <onboarding@resend.dev>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
